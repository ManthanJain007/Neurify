{
  "manifest_version": 3,
  "name": "AI Writing Assistant Pro - 50+ Features",
  "version": "3.0.0",
  "description": "Professional-grade writing assistance with 50+ features including advanced grammar checking, text humanization, tone analysis, comprehensive style enhancement, real-time analysis, content optimization, and personalized learning powered by Gemini AI.",
  
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus",
    "identity",
    "notifications",
    "tabs",
    "declarativeNetRequest"
  ],
  
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Writing Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  
  "options_page": "options.html",
  
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "commands": {
    "toggle-assistant": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Toggle AI Writing Assistant"
    },
    "quick-humanize": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Quick humanize selected text"
    },
    "grammar-check": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "Check grammar in selected text"
    },
    "enhance-style": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Enhance writing style"
    }
  },
  
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["<all_urls>"]
    }
  ]
}